---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  ogImage?: string;
  updatedAt?: string;
  author?: string;
  readingEntry?: boolean;
}
const { title, description, canonical, noindex = false, jsonLd = [], updatedAt, author } = Astro.props;
const ogImage = Astro.props.ogImage ?? `${(Astro.site ?? new URL('https://tarot-tools.example.com')).toString().replace(/\/$/, '')}/og-default.png`;
const site = (Astro.site ?? new URL('https://tarot-tools.example.com')).toString().replace(/\/$/, '');
const path = Astro.url.pathname;
const canonicalUrl = canonical ?? `${site}${path}`;
const turnstileKey = Astro.locals.runtime?.env?.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const baseLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Tarot Tools', url: site },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Tarot Tools', url: site, email: 'support@tarot-tools.example.com' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Tarot Tools" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080b12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/app-icon.svg" />
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    {author && <meta name="author" content={author} />}
    {[...baseLd, ...jsonLd].map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    {turnstileKey && <meta name="turnstile-site-key" content={turnstileKey} />}
    <link rel="preload" href="/fonts/instrument-serif-regular.v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/reading-table.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Tarot Tools home"><img src="/brand/logo-horizontal-dark.svg" alt="" width="166" height="32" /></a>
      <nav aria-label="Primary">
        <a href="/">Card Generator</a>
        <a href="/free-tarot-reading/">Free Reading</a>
        <a href="/cards/">Card Meanings</a>
        <a href="/spreads/">Spreads</a>
        <a href="/questions/">Questions</a>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <nav class="mobile-dock" aria-label="Mobile navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="6" y="3" width="12" height="18" rx="2" /><path d="m12 8 3 4-3 4-3-4z" /></svg>Draw</a>
      <a href="/cards/" aria-current={path.startsWith('/cards') ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="7" height="16" rx="1" /><rect x="14" y="4" width="7" height="16" rx="1" /></svg>The deck</a>
      <a href="/spreads/" aria-current={path.startsWith('/spreads') ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7h4v12H3zM10 3h4v16h-4zM17 7h4v12h-4z" /></svg>Spreads</a>
      <a href="/methodology/" aria-current={path === '/methodology/' ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7v1" /></svg>How it works</a>
    </nav>
    <footer class="site-footer">
      <p class="muted">For reflection and entertainment only. Not medical, legal, financial or psychological advice. 18+.</p>
      <nav aria-label="Footer">
        <a href="/methodology/">How it works</a>
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/refund/">Refunds</a>
        <a href="/holo-card-license.txt">Visual credits</a>
      </nav>
      <p class="muted">© {new Date().getFullYear()} Tarot Tools. Hosted on Cloudflare.</p>
    </footer>
    {turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </body>
</html>
