{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-tools",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tarot-db", "database_id": "b40842ec-7013-4544-9977-c04bad7a8f58", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "6e7e931b38d5466a812bdcc34b0b78fc" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tarot-media" }],
  "images": { "binding": "IMAGES" },
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "REPORT_QUEUE", "queue": "tarot-reports" }],
    "consumers": [{ "queue": "tarot-reports", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3 }]
  },
  "workflows": [
    { "name": "tarot-report-workflow", "binding": "REPORT_WORKFLOW", "class_name": "ReportWorkflow" }
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "tarot_events" }],
  "triggers": { "crons": ["0 3 * * *", "*/10 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://tarot-tools.me7o.workers.dev",
    "AI_GATEWAY_ID": "tarot-gateway",
    "AI_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "REPORT_PRICE_SINGLE_CENTS": "499",
    "REPORT_PRICE_THREE_CENTS": "999",
    "WAFFO_PRODUCT_SINGLE": "PROD_214CNkqnBu0hykZy0SSnaB",
    "WAFFO_PRODUCT_THREE": "PROD_7CNWww58bA6wZHDPRozUTu",
    "WAFFO_WEBHOOK_PUBLIC_KEY": ""
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "preview": {
      "name": "tarot-tools-preview",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "vars": { "ENVIRONMENT": "preview", "SITE_URL": "https://tarot-tools-preview.me7o.workers.dev", "AI_GATEWAY_ID": "tarot-gateway", "AI_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017", "REPORT_PRICE_SINGLE_CENTS": "499", "REPORT_PRICE_THREE_CENTS": "999" },
      "d1_databases": [{ "binding": "DB", "database_name": "tarot-db-preview", "database_id": "463399d8-55ab-49d8-819d-2ba8b1eaa299", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "84029e0f7cb24b1097b67842179c2cbc" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tarot-media-preview" }],
      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [{ "binding": "REPORT_QUEUE", "queue": "tarot-reports-preview" }],
        "consumers": [{ "queue": "tarot-reports-preview", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3 }]
      },
      "workflows": [{ "name": "tarot-report-workflow-preview", "binding": "REPORT_WORKFLOW", "class_name": "ReportWorkflow" }],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "tarot_events_preview" }],
      "triggers": { "crons": [] }
    }
  }
}
